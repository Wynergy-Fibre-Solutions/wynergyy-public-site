{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ACE Dormant Capability Tree",
  "type": "object",
  "required": ["engine", "version", "governance", "roots"],
  "properties": {
    "engine": { "type": "string", "const": "ACE" },
    "version": { "type": "string" },
    "governance": {
      "type": "object",
      "required": ["mode", "exposed", "note"],
      "properties": {
        "mode": { "type": "string", "const": "structure-only" },
        "exposed": { "type": "boolean", "const": false },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/node" }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id", "label", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9\\-]+$"
        },
        "label": { "type": "string" },
        "status": { "type": "string", "const": "dormant" },
        "governance_note": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/node" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
