{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"ACE Content Lifecycle (Dormant)",
  "type":"object",
  "required":["engine","version","governance","states"],
  "properties":{
    "engine":{"type":"string","const":"ACE"},
    "version":{"type":"string"},
    "governance":{
      "type":"object",
      "required":["mode","exposed","note"],
      "properties":{
        "mode":{"type":"string","const":"structure-only"},
        "exposed":{"type":"boolean","const":false},
        "note":{"type":"string"}
      },
      "additionalProperties":false
    },
    "states":{
      "type":"array",
      "items":{"type":"string","enum":["draft","reviewed","approved","retired"]}
    }
  },
  "additionalProperties":false
}
