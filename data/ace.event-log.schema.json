{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"ACE Event Log (Dormant)",
  "type":"object",
  "required":["engine","version","governance","events"],
  "properties":{
    "engine":{"type":"string","const":"ACE"},
    "version":{"type":"string"},
    "governance":{
      "type":"object",
      "required":["mode","exposed","note"],
      "properties":{
        "mode":{"type":"string","const":"structure-only"},
        "exposed":{"type":"boolean","const":false},
        "note":{"type":"string"}
      }
    },
    "events":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["id","timestamp","type"],
        "properties":{
          "id":{"type":"string"},
          "timestamp":{"type":"string"},
          "type":{"type":"string"}
        }
      }
    }
  }
}
