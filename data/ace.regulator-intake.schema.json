{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ACE Regulator Intake (Dormant)",
  "type": "object",
  "required": ["engine", "version", "governance", "form"],
  "properties": {
    "engine": { "type": "string", "const": "ACE" },
    "version": { "type": "string" },
    "governance": {
      "type": "object",
      "required": ["mode", "exposed", "note"],
      "properties": {
        "mode": { "type": "string", "const": "structure-only" },
        "exposed": { "type": "boolean", "const": false },
        "note": { "type": "string" }
      }
    },
    "form": {
      "type": "object",
      "required": ["sections"]
    }
  }
}
