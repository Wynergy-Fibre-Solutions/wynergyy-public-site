{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"ACE Incident Framework (Dormant)",
  "type":"object",
  "required":["engine","version","governance","levels"],
  "properties":{
    "engine":{"type":"string","const":"ACE"},
    "version":{"type":"string"},
    "governance":{
      "type":"object",
      "required":["mode","exposed","note"],
      "properties":{
        "mode":{"type":"string","const":"structure-only"},
        "exposed":{"type":"boolean","const":false},
        "note":{"type":"string"}
      }
    },
    "levels":{"type":"array","items":{"type":"string"}}
  }
}
