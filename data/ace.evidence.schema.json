{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ACE Evidence Hooks (Dormant)",
  "type": "object",
  "required": ["engine", "version", "governance", "evidence_domains"],
  "properties": {
    "engine": { "type": "string", "const": "ACE" },
    "version": { "type": "string" },
    "governance": {
      "type": "object",
      "required": ["mode", "exposed", "note"],
      "properties": {
        "mode": { "type": "string", "const": "structure-only" },
        "exposed": { "type": "boolean", "const": false },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidence_domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "status", "items"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9\\-]+$" },
          "label": { "type": "string" },
          "status": { "type": "string", "const": "dormant" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "type", "status"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9\\-]+$" },
                "label": { "type": "string" },
                "type": { "type": "string" },
                "status": { "type": "string", "const": "dormant" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
